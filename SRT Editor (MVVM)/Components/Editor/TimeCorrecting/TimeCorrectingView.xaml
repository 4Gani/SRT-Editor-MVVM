<UserControl x:Class="SRTEditor_MVVM.Components.Editor.TimeCorrecting.TimeCorrectingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SRTEditor_MVVM.Components.Editor.TimeCorrecting"
             mc:Ignorable="d" 
             d:DesignHeight="290" d:DesignWidth="684">

    <Canvas>
        <Grid Background="{StaticResource appDisableBackground}"
              Width="684" Height="5" VerticalAlignment="Top"/>
        <Grid Background="{StaticResource appColorBackground}"
              Width="170" Height="5" VerticalAlignment="Top"
              Canvas.Left="342"></Grid>

        <TextBlock Width="564" Height="50"
                   TextWrapping="Wrap" TextAlignment="Center"
                   Canvas.Left="60" Canvas.Top="45">
            Use Time Correcting to set the correct timestamp for the last line — all other lines will be adjusted automatically
        </TextBlock>

        <Label Content="Correct Time:"
               Height="32" Width="92" FontWeight="Normal"
               Canvas.Left="245" Canvas.Top="113" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        <TextBox Text="{Binding TimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                 Width="85" Height="32" MaxLength="8"
                 PreviewTextInput="TimeOnly"
                 TextWrapping="Wrap" TextAlignment="Center" FontSize="14"
                 VerticalContentAlignment="Center"
                 Canvas.Left="342" Canvas.Top="113" HorizontalAlignment="Center" VerticalAlignment="Top"/>

        <Label Content="(Format: hh:mm:ss)"
               Width="128" Height="30" VerticalAlignment="Center" FontFamily="Segoe UI Italic" FontSize="12"
               Canvas.Left="330" Canvas.Top="150" HorizontalAlignment="Left"/>

        <Button Content="Correct" Command="{Binding TimeCorrectingCommand}"
                Style="{StaticResource normalButton}"
                Canvas.Left="292" Canvas.Top="213"/>
    </Canvas>
</UserControl>
