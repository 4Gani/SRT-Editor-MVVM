<UserControl x:Class="SRTEditor_MVVM.Components.Editor.TimeShifting.TimeShiftingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SRTEditor_MVVM.Components.Editor.TimeShifting"
             xmlns:helperClass="clr-namespace:SRTEditor_MVVM.Infrastructure"
             mc:Ignorable="d" 
             d:DesignHeight="290" d:DesignWidth="684">

    <UserControl.Resources>
        <ResourceDictionary>
            <helperClass:BooleanConverter x:Key="BooleanConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Canvas>
        <Grid Background="{StaticResource appDisableBackground}"
              Width="684" Height="5" VerticalAlignment="Top"/>
        <Grid Background="{StaticResource appColorBackground}"
              Width="170" Height="5" VerticalAlignment="Top"
              Canvas.Left="172"/>

        <TextBlock Width="564" Height="25"
                   TextWrapping="Wrap" TextAlignment="Center"
                   Canvas.Left="60" Canvas.Top="45">
            Use Time Shifting to adjust timestamps for all or selected lines
        </TextBlock>

        <Label Content="From:"
               Height="32" Width="45"
               IsEnabled="{Binding ElementName=checkBoxAllLines, Path=IsChecked, Converter={StaticResource BooleanConverter}}"
               Canvas.Left="42" Canvas.Top="89"/>
        <TextBox Text="{Binding FromLineNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" 
                 IsEnabled="{Binding ElementName=checkBoxAllLines, Path=IsChecked, Converter={StaticResource BooleanConverter}}"
                 TextWrapping="Wrap" VerticalContentAlignment="Center"
                 PreviewTextInput="NumericOnly" MaxLength="6" FontSize="14"
                 Width="80" Height="32" Canvas.Left="92" Canvas.Top="89"/>

        <Label Content="To:"
               Height="32" Width="28"
               IsEnabled="{Binding ElementName=checkBoxAllLines, Path=IsChecked, Converter={StaticResource BooleanConverter}}"
               Canvas.Left="59" Canvas.Top="126"/>
        <TextBox Text="{Binding ToLineNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                 IsEnabled="{Binding ElementName=checkBoxAllLines, Path=IsChecked, Converter={StaticResource BooleanConverter}}"
                 TextWrapping="Wrap" VerticalContentAlignment="Center"
                 PreviewTextInput="NumericOnly" MaxLength="6" FontSize="14"
                 Width="80" Height="32" Canvas.Left="92" Canvas.Top="126"/>

        <CheckBox x:Name="checkBoxAllLines" Content="Apply to all lines"
                  IsChecked="{Binding IsApplyToAllLines, Mode=TwoWay}"
                  Width="168" Height="32" FontWeight="Bold"
                  VerticalContentAlignment="Center"
                  Canvas.Left="68" Canvas.Top="173"/>

        <RadioButton Content="Raise"
                     IsChecked="{Binding IsRaised, Mode=TwoWay}"
                     Width="80" Height="32" 
                     VerticalContentAlignment="Center"
                     Canvas.Left="201" Canvas.Top="89"/>
        <RadioButton Content="Reduce"
                     Width="80" Height="32"
                     VerticalContentAlignment="Center"
                     Canvas.Left="201" Canvas.Top="126"/>

        <Label Content="Time Difference:"
               Width="111" Height="32"
               Canvas.Left="397" Canvas.Top="89" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <TextBox Text="{Binding TimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                 Width="100" Height="32" MaxLength="12"
                 PreviewTextInput="TimeOnly"
                 TextAlignment="Center"
                 VerticalContentAlignment="Center" FontSize="14"
                 Canvas.Left="513" Canvas.Top="89"/>

        <Label Content="(Format: hh:mm:ss.sss)"
               Width="161" Height="32" FontFamily="Segoe UI Italic" FontSize="12"
               Canvas.Left="500" Canvas.Top="126" HorizontalAlignment="Left" VerticalAlignment="Center"/>

        <Button Content="Shift" Command="{Binding ChangeCommand}"
                Style="{StaticResource normalButton}"
                Canvas.Left="242" Canvas.Top="213"/>
        <Button Content="Clear" Command="{Binding ClearCommand}"
                ToolTip="Clear text boxes"
                Style="{StaticResource normalButton}"
                Canvas.Left="347" Canvas.Top="213"/>
    </Canvas>
</UserControl>
