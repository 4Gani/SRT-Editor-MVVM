<Window x:Class="SRTEditor_MVVM.Components.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SRTEditor_MVVM.Components"
        xmlns:Editor="clr-namespace:SRTEditor_MVVM.Components.Editor.Container"
        xmlns:Viewer="clr-namespace:SRTEditor_MVVM.Components.Viewer"
        mc:Ignorable="d"
        Height="785" Width="1120"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI Semilight" FontSize="14">

    <Window.DataContext>
        <local:MainWindowViewModel />
    </Window.DataContext>
    
    <Window.Resources>
        <ResourceDictionary>
            <DataTemplate DataType="{x:Type Editor:ContainerViewModel}">
                <Editor:ContainerView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type Viewer:FileViewerViewModel}">
                <Viewer:FileViewerView />
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>


    <Grid Background="{StaticResource appMainBackground}" Margin="10">
        <Grid.Effect>
            <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="1"
                              RenderingBias="Quality"/>
        </Grid.Effect>

        <Grid.RowDefinitions>
            <RowDefinition Height="106"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <local:TitleBarView Grid.Row="0"/>

        <!-- Tabs -->
        <TabControl Width="1060" BorderThickness="0" Padding="0,0,0,0" Grid.Row="1">

            <TabItem Header="Editor" Width="250" Height="32"
                     Background="{StaticResource appMainBackground}">
                <ContentControl Content="{Binding ContainerViewModel}"/>
            </TabItem>

            <TabItem Header="Viewer" Width="250"
                     IsEnabled="{Binding IsSrtFileSet}"
                     Background="{StaticResource appMainBackground}">
                <ContentControl Content="{Binding FileViewerViewModel}"/>
            </TabItem>
        </TabControl>

    </Grid>
</Window>
