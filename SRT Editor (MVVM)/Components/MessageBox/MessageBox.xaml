<Window x:Class="SRTEditor_MVVM.Components.MessageBox.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:SRTEditor_MVVM.Components.MessageBox"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="500" Height="250"
        FontFamily="Segoe UI Semilight" FontSize="16">

    <Window.Resources>
        <ResourceDictionary Source="/Resources/MyResourceDictionary.xaml"/>
    </Window.Resources>

    <Grid Background="{StaticResource appMainBackground}" Margin="10,10,10,25">
        <Grid.Effect>
            <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="1"
                              RenderingBias="Quality"/>
        </Grid.Effect>

        <!-- Color bar at the top -->
        <Rectangle Fill="{StaticResource appColorBackground}" Height="6" VerticalAlignment="Top"/>

        <!-- Icon and title area -->
        <StackPanel Width="264" Height="80" Orientation="Horizontal"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="48,20,0,0">

            <!-- Icon bound to ViewModel's MessageImageSource -->
            <Image Source="{Binding MessageImageSource}" Width="35" Height="36"/>
            <!-- Title bound to ViewModel's MessageTitle -->
            <Label Content="{Binding MessageTitle}" Width="201" Height="80"
                   VerticalContentAlignment="Center"
                   FontSize="32" FontWeight="Bold"/>
        </StackPanel>

        <!-- Message text bound to ViewModel's MessageText -->
        <TextBlock Text="{Binding MessageText}" Width="376" MinHeight="30"
                   HorizontalAlignment="Center" VerticalAlignment="Top"
                   TextAlignment="Left" TextWrapping="Wrap" Margin="0,101,0,0"/>

        <!-- Button panel — populated dynamically in code-behind -->
        <StackPanel x:Name="MessageBoxPanel" Margin="10"
                    Width="Auto" Height="52" Orientation="Horizontal"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
    </Grid>
</Window>