<UserControl x:Class="SRTEditor_MVVM.Components.TitleBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:SRTEditor_MVVM.Components"
             mc:Ignorable="d" 
             d:DesignHeight="106" d:DesignWidth="1100">

    <UserControl.DataContext>
        <local:TitleBarViewModel/>
    </UserControl.DataContext>

    <Grid>
        
        <!-- color Bar -->
        <Rectangle Fill="{StaticResource appColorBackground}" Height="6" VerticalAlignment="Top"/>

        <!-- Title Bar -->
        <Rectangle Fill="Transparent" Margin="0,6,0,10">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseDown">
                    <i:InvokeCommandAction Command="{Binding DragCommand}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </Rectangle>

        <Button Command="{Binding CloseCommand}" Content="X" ToolTip="Close"
                Style="{StaticResource titleBarButton}" Margin="0,6,0,0"/>
        <Button Command="{Binding MinimizeCommand}" Content="_" ToolTip="Minimize"
                Style="{StaticResource titleBarButton}" Margin="0,6,35,0"
                 FontFamily="Sigmar One"/>

        <Image Source="/Assets/Icon.png" Width="50" HorizontalAlignment="Left" Margin="0,0,0,50"/>

        <TextBlock Text="SRT Editor (Version 4.0)"
                   Width="362" HorizontalAlignment="Left" Margin="50,34,0,10"
                   TextAlignment="Left" FontFamily="Segoe UI Semilight" FontSize="36">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseDown">
                    <i:InvokeCommandAction Command="{Binding DragCommand}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </TextBlock>
        <Label Content="Created by 4Gani"
               Width="106" Height="28" Margin="410,56,0,0"
               HorizontalAlignment="Left" VerticalAlignment="Top"
               FontSize="11">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseDown">
                    <i:InvokeCommandAction Command="{Binding DragCommand}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </Label>

    </Grid>
</UserControl>
