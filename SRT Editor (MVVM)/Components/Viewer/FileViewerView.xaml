<UserControl x:Class="SRTEditor_MVVM.Components.Viewer.FileViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:SRTEditor_MVVM.Components.Viewer"
             xmlns:helperClass="clr-namespace:SRTEditor_MVVM.Infrastructure"
             mc:Ignorable="d" 
             d:DesignHeight="644" d:DesignWidth="1060">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <i:Interaction.Triggers>
            <i:EventTrigger EventName="Loaded">
                <i:InvokeCommandAction Command="{Binding SelectionChangedCommand}"/>
            </i:EventTrigger>
        </i:Interaction.Triggers>
        
        <Grid Grid.Row="0" Background="{StaticResource appDisableBackground}"
              Width="1060" Height="5" VerticalAlignment="Top"/>
        <Grid Grid.Row="0" Background="{StaticResource appColorBackground}"
              Height="5" VerticalAlignment="Top" Margin="252,0,558,0"/>

        <Label Grid.Row="1" Content="{Binding FileName}"
               Width="1000" Height="35" VerticalAlignment="Top"/>
        <Button Content="Save Changes" Command="{Binding SaveCommand}"
                Style="{StaticResource normalButton}"
                Grid.RowSpan="2" Width="115" Margin="915,16,0,0"
                HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <RichTextBox helperClass:RichTextboxHelper.BoundDocument="{Binding FileContents, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     Grid.Row="2" Width="1000" Height="520" VerticalAlignment="Top"
                     FontSize="16" VerticalScrollBarVisibility="Auto">
           
            <RichTextBox.Resources>
                <Style TargetType="{x:Type Paragraph}">
                    <Setter Property="Margin" Value="0.5"/>
                </Style>
            </RichTextBox.Resources>
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="TextChanged">
                    <i:InvokeCommandAction Command="{Binding TextChangedCommand}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </RichTextBox>

        <Label Grid.Row="2" Content="Changes saved successfully"
               Width="200" Height="25" Margin="-5,0,865,10"
               FontSize="11" VerticalAlignment="Bottom"
               Visibility="{Binding IsMessageVisible}"/>

    </Grid>
</UserControl>
